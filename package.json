{
  "name": "megagrid-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @megagrid/playground",
    "test": "npm run test -w @megagrid/core",
    "test:watch": "npm run test:watch -w @megagrid/core",
    "build": "npm run build -w @megagrid/core && npm run build -w @megagrid/grid && npm run build -w @megagrid/playground"
  },
  "engines": {
    "node": ">=20"
  }
}
