{
  "name": "titangrid",
  "version": "0.2.0",
  "description": "High-performance canvas data grid",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/titangrid.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/titangrid.js",
  "jsdelivr": "./dist/titangrid.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/styles.css",
    "dist/titangrid.js",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.cdn.config.ts && cp src/styles.css dist/styles.css",
    "build:cdn": "vite build -c vite.cdn.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint --pack npm && attw --pack . --profile esm-only --exclude-entrypoints styles.css package.json && node scripts/check-size.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fityp/TitanGrid.git",
    "directory": "packages/grid"
  },
  "homepage": "https://fityp.github.io/TitanGrid/",
  "bugs": {
    "url": "https://github.com/fityp/TitanGrid/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "happy-dom": "^18.0.1",
    "publint": "^0.3.24",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.7"
  }
}
