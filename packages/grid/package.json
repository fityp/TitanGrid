{
  "name": "titangrid",
  "version": "0.1.2",
  "description": "High-performance canvas data grid",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./dist/titangrid.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/titangrid.js",
  "jsdelivr": "./dist/titangrid.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && vite build -c vite.cdn.config.ts && cp src/styles.css dist/styles.css",
    "build:cdn": "vite build -c vite.cdn.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fityp/TitanGrid.git",
    "directory": "packages/grid"
  },
  "homepage": "https://fityp.github.io/TitanGrid/",
  "bugs": {
    "url": "https://github.com/fityp/TitanGrid/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4"
  }
}
